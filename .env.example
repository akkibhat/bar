# Bar Assistant, for `npm run pull` only.
#
# These are read by scripts/pull-backbar.mjs when regenerating the shelf
# snapshot, and by nothing else. The built site is static: it carries no
# token, makes no requests, and does not need this file to run or deploy.
#
# Copy to .env.local and fill in. .env.local is gitignored.

# Give this its own hostname, not the one the site is on. Both used to be
# bar.pi.co.nz - the site on Cloudflare and the API proxied at /bar - and
# the moment the site took that name over, every path went to the static
# export and the pull broke with a 404 that looked like a dead server.
# Your instance's API base, including the /bar/api path. If
# https://yourhost/bar on its own says "This is your Bar Assistant
# instance", this is the right path.
BA_API_URL=https://bar.example.com/bar/api

# Salt Rim -> Settings -> API -> create a token. Read-only is enough:
# the pull script only ever reads.
BA_API_TOKEN=

# The bar's id, from the URL in Salt Rim.
BA_BAR_ID=1

# Only recipes in this collection are published - everything else in the
# book stays private. A read-only token cannot list collections by name,
# so this has to be the numeric id, which is in the Salt Rim URL when
# viewing the collection.
BA_COLLECTION_ID=

# Check the values work before blaming the script:
#
#   curl -H "Authorization: Bearer $BA_API_TOKEN" \
#        -H "Bar-Assistant-Bar-Id: $BA_BAR_ID" \
#        "$BA_API_URL/cocktails?per_page=1"
